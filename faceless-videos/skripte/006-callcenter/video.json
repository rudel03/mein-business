   "shot": "hook",
   "audio": "audio/01.mp3",
   "text": "Jede Minute, die du mit einer Hotline telefonierst, kann einer Firma Geld bringen. Nur nicht der, die du angerufen hast."
  },
  {
   "shot": "intro",
   "audio": "audio/02.mp3",
   "text": "Callcenter. Ein Geschäft, das jeder kennt und keiner versteht. Und das Ende ist komplett absurd.",
   "labels": [
    {
     "word": "Callcenter.",
     "text": "CALLCENTER",
     "dur": 2.0,
     "color": "yellow"
    }
   ]
  },
  {
   "shot": "outsource",
   "audio": "audio/03.mp3",
   "text": "Viele Firmen lagern ihre Hotline an Dienstleister aus. Abgerechnet wird pro Minute, pro Anruf oder pro Stunde.",
   "labels": [
    {
     "word": "Minute,",
     "text": "PRO MINUTE · PRO ANRUF · PRO STUNDE",
     "dur": 3.0,
     "color": "white"
    }
   ]
  },
  {
   "shot": "perMinute",
   "audio": "audio/04.mp3",
   "text": "In Deutschland sind das so 50 Cent bis 1,20 Euro pro Gesprächsminute.",
   "labels": [
    {
     "word": "50",
     "text": "0,50–1,20 € PRO MINUTE",
     "dur": 2.8,
     "color": "yellow"
    }
   ]
  },
  {
   "shot": "perHour",
   "audio": "audio/05.mp3",
   "text": "Oder pro Mitarbeiterstunde: 25 bis 45 Euro.",
   "labels": [
    {
     "word": "25",
     "text": "25–45 € PRO STUNDE",
     "dur": 2.6,
     "color": "yellow"
    }
   ]
  },
  {
   "shot": "wage",
   "audio": "audio/06.mp3",
   "text": "Der Mensch am Telefon kriegt mindestens Mindestlohn, 13,90 Euro. Der Rest zahlt Miete, Technik, Chefs und Gewinn.",
   "labels": [
    {
     "word": "13,90",
     "text": "MINDESTLOHN: 13,90 €",
     "dur": 2.6,
     "color": "white",
     "y": 420
    },
    {
     "word": "Gewinn.",
     "text": "GEWINN",
     "dur": 1.6,
     "color": "green"
    }
   ]
  },
  {
   "shot": "mass",
   "audio": "audio/07.mp3",
   "text": "Der Trick ist Masse. Hunderte Plätze, Schichtbetrieb, und jede besetzte Minute wird verkauft.",
   "labels": [
    {
     "word": "Masse.",
     "text": "MASSE",
     "dur": 1.8,
     "color": "yellow"
    }
   ]
  },
  {
   "shot": "commission",
   "audio": "audio/08.mp3",
   "text": "Beim Verkaufen am Telefon gibt's oft Provision pro Abschluss. Deshalb sind manche so verdammt hartnäckig.",
