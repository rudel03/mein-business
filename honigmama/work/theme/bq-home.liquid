{% assign item = section.settings.product %}
{% assign selected = item.selected_or_first_available_variant %}{% assign hero_id = 'bq-home-hero-' | append: section.id %}{% assign offer_id = hero_id | append: '-offer' %}{% assign end_id = hero_id | append: '-end' %}{% assign sticky_id = hero_id | append: '-sticky' %}{% assign bee_id = hero_id | append: '-bee' %}{% assign value_id = hero_id | append: '-value' %}{% assign angle_id = hero_id | append: '-angle' %}{% assign gallery_id = 'bq-gallery-' | append: section.id %}{% assign per_recipe = selected.price | divided_by: 70 %}
<section class="bq-hero">
{% render 'bq-drip' %}
<div class="bq-wrap bq-hero__grid">
<div class="bq-hero__heading"><p class="bq-eyebrow">{{ 'bq.home.eyebrow' | t }}</p><h1>{{ 'bq.home.title1' | t }}<br><em>{{ 'bq.home.title2' | t }}</em></h1></div>
<figure class="bq-hero__art"><span class="bq-hero__halo" aria-hidden="true"></span>
{% if section.settings.mascot != blank %}{{ section.settings.mascot | image_url: width: 1000 | image_tag: class: 'bq-hero__queen', loading: 'eager', fetchpriority: 'high', widths: '360,600,800,1000', sizes: '(min-width: 800px) 430px, 180px', alt: section.settings.mascot_alt }}{% endif %}
{% if section.settings.cover != blank %}{{ section.settings.cover | image_url: width: 600 | image_tag: class: 'bq-hero__cover', loading: 'eager', widths: '200,400,600', sizes: '(min-width: 800px) 170px, 94px', alt: item.title }}{% endif %}
<span class="bq-hero__stamp" aria-hidden="true">{% render 'bq-icon', name: 'book' %}</span>
</figure>
<div class="bq-hero__copy"><ul class="bq-hero-points">{% for i in (1..3) %}{% assign point_key = 'bq.home.hero_point' | append: i %}<li>{% render 'bq-icon', name: 'check' %}<span>{{ point_key | t }}</span></li>{% endfor %}</ul><p class="bq-hero__price">{{ selected.price | money }} <span>· einmalig · nur {{ per_recipe | money }} pro Rezept</span></p><div data-bq-cta>{% render 'bq-purchase', item: item, form_id: hero_id, compact: true %}</div><a class="bq-peek-link" href="#bq-gerichte">Diese Gerichte kochst du{% render 'bq-icon', name: 'arrow' %}</a></div>
</div>
</section>
{% render 'bq-press', item: item %}
{% render 'bq-dishes' %}
{% render 'bq-bee-promise', item: item, form_id: bee_id %}
<section class="bq-section bq-preview-section" id="vorschau"><div class="bq-wrap"><div class="bq-section-head"><div><p class="bq-eyebrow">Ein Blick ins Buch</p><h2>So sieht dein Buch von innen aus.</h2></div><a class="bq-link" href="{{ item.url }}">Zum Kochbuch{% render 'bq-icon', name: 'arrow' %}</a></div>{% render 'bq-book-carousel', item: item, gallery_id: gallery_id %}</div></section>
{% render 'bq-value', item: item, form_id: value_id %}
{% render 'bq-angles', item: item, form_id: angle_id %}
{% render 'bq-reviews', item: item %}
<section class="bq-section"><div class="bq-wrap bq-end"><h2>{{ 'bq.home.end_title' | t }}</h2><p>{{ 'bq.home.end_text' | t }}</p><div data-bq-cta>{% render 'bq-purchase', item: item, form_id: end_id %}</div>
<div class="bq-probe" id="bq-probieren"><div><h3>{{ 'bq.home.probe_title' | t }}</h3><p>{{ 'bq.home.probe_text' | t }}</p></div>
{% form 'customer', id: 'bq-probe-form', class: 'bq-email-form' %}<input type="hidden" name="contact[tags]" value="newsletter, probierheft">
{% if form.posted_successfully? %}<p role="status">{{ 'bq.home.probe_success' | t }}</p>{% else %}{% if form.errors %}<div class="bq-error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}<label for="bq-probe-email">{{ 'bq.home.email' | t }}</label><input id="bq-probe-email" type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" required placeholder="name@beispiel.de"><label class="bq-consent"><input type="checkbox" name="contact[accepts_marketing]" value="true" required><span>{{ 'bq.home.probe_consent' | t }}{% if pages['datenschutz'] != blank %} <a href="{{ pages['datenschutz'].url }}">{{ 'bq.nav.privacy' | t }}</a>{% elsif shop.privacy_policy.body != blank %} <a href="{{ shop.privacy_policy.url }}">{{ 'bq.nav.privacy' | t }}</a>{% endif %}</span></label><button class="bq-button bq-button--outline" type="submit">{{ 'bq.home.probe_cta' | t }}</button>{% endif %}
{% endform %}</div></div></section>
<aside class="bq-sticky" data-bq-sticky hidden aria-label="{{ 'bq.product.sticky' | t }}"><div class="bq-sticky__inner"><div class="bq-sticky__product">{% if item.featured_image != blank %}{{ item.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{% endif %}<div><strong>{{ item.title | escape }}</strong><span>{% if selected.price > 0 %}{{ selected.price | money }} · {% endif %}70 Rezepte · PDF</span></div></div>{% render 'bq-purchase', item: item, form_id: sticky_id, compact: true, sticky: true %}<p class="bq-sticky__trust">{% render 'bq-icon', name: 'lock' %}{{ 'bq.trust.checkout' | t }} <span>· {{ 'bq.trust.pdf' | t }}</span></p></div></aside>
{% render 'bq-buy-dialog' %}
{% render 'bq-image-dialog', item: item %}
{% schema %}
{"name":"BeeQueen: Honig-Start","settings":[{"type":"product","id":"product","label":"Kochbuch"},{"type":"image_picker","id":"mascot","label":"Bienenkönigin"},{"type":"text","id":"mascot_alt","label":"Bildbeschreibung"},{"type":"image_picker","id":"cover","label":"Buchcover"},{"type":"image_picker","id":"offer_image","label":"Produktansicht"},{"type":"image_picker","id":"peek_image","label":"Rezept-Doppelseite"},{"type":"text","id":"peek_alt","label":"Beschreibung der Buchansicht"}],"blocks":[{"type":"reason","name":"Alltagsvorteil","settings":[{"type":"select","id":"icon","label":"Symbol","options":[{"value":"book","label":"Buch"},{"value":"plan","label":"Plan"},{"value":"check","label":"Haken"}],"default":"book"},{"type":"text","id":"title","label":"Überschrift"},{"type":"textarea","id":"text","label":"Erklärung"}]}],"presets":[{"name":"BeeQueen: Honig-Start"}]}
{% endschema %}


